<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] [requestId=%X{requestId:-}] [sessionId=%X{sessionId:-}] [ip=%X{clientIp:-}] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Raise to DEBUG through APP_LOG_LEVEL to see yt-dlp's raw output while diagnosing a
         resolution failure, without a code change. -->
    <logger name="io.github.rubenix.yttranscriber" level="${APP_LOG_LEVEL:-INFO}"/>

</configuration>
