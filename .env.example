TRANSLATION_API_KEY=

MAX_VIDEO_DURATION_SECONDS=1200
MAX_REQUESTS_PER_HOUR=3
MAX_AUDIO_MINUTES_PER_HOUR=60
MAX_CONCURRENT_TRANSCRIPTIONS=2

YTDLP_BINARY_PATH=yt-dlp
YTDLP_TIMEOUT_SECONDS=45

# Local Speech-to-Text fallback for videos with no captions in any language. Runs entirely
# locally via whisper.cpp -- no external API, no per-request cost. Requires `whisper-cli`
# installed (e.g. `brew install whisper-cpp`) and a ggml model downloaded separately
# (https://huggingface.co/ggerganov/whisper.cpp). Leave WHISPER_MODEL_PATH empty to disable --
# the app runs fine without it, that fallback path just reports "service unavailable".
WHISPER_BINARY_PATH=whisper-cli
WHISPER_MODEL_PATH=
WHISPER_TIMEOUT_SECONDS=900

CORS_ALLOWED_ORIGINS=http://localhost:4321
